        "import random\n",
        "import requests\n",
        "\n",
        "roasts = [\"Roses are red, violets are blue\\nHere's what I say to this joke, AAAAAATHOOOOOOO!\",\"This joke is so old, I've already heard it\\nBut because its trash, the government won't allow me to burn it.\",\"This joke is so cheap, its worth just a dime\\nBye bye, see you, sorry for wasting your time.\",\"This joke is so bad, it has a book\\nChapter 1, this joke is cooked\",\"This joke is boring, even for nerds\\nTo try and roast it, the dictionary had to add new words.\",\"Roses are red, violets are blue\\nAfter reading this joke, I feel sorry for you.\",\"Twinkle Twinkle, little star!\\nI'll hit this joke with a metal bar!\"]\n",
        "\n",
        "def get_random_joke():\n",
        "  url = \"https://official-joke-api.appspot.com/random_joke\"\n",
        "  response = requests.get(url)\n",
        "\n",
        "  if response.status_code == 200:\n",
        "    joke_data = response.json()\n",
        "    return f\"{joke_data['setup']} - {joke_data['punchline']}\"\n",
        "  else:\n",
        "    return \"Failed to fetch a joke.\"\n",
        "\n",
        "def main():\n",
        "  print(\"RANDOM CRINGE AND CLICHE JOKES BECAUSE WHY NOT!\")\n",
        "\n",
        "  while True:\n",
        "    user_input = input(\"Press enter for a new joke, or type 'q'/'exit' to quit: \").strip().lower()\n",
        "\n",
        "    if user_input in ('q', 'exit'):\n",
        "      break\n",
        "\n",
        "    joke = get_random_joke()\n",
        "    print(joke)\n",
        "    print(roasts[random.randint(0,6)])\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "  main()"
      ]
